# ShieldSafe Environment Configuration
# Copy this file to .env and adjust as needed

# Server configuration
PORT=3001
NODE_ENV=development

# Database configuration (relative to server directory)
DATABASE_PATH=./data/shieldsafe.db

# CORS — set to client origin in production
CORS_ORIGIN=http://localhost:5173

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Journey share tokens
SHARE_TOKEN_EXPIRY_HOURS=24

# Optional: Set to 'true' to seed demo data on first run
SEED_DEMO_DATA=true
